# ── PredMaint Environment Variables ──────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── API ──────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ── MQTT Broker ───────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ── Simulator ─────────────────────────────────────────
SIM_INTERVAL=2.0

# ── Model tuning ──────────────────────────────────────
WINDOW_SIZE=30
AE_EPOCHS=30
RF_N_EST=200
GB_N_EST=300

# ── RUL alert thresholds (cycles) ─────────────────────
RUL_CRIT=100
RUL_WARN=500
RUL_MOD=1500

# ── Email alerts (optional) ───────────────────────────
ALERT_EMAIL_FROM=
ALERT_EMAIL_PASS=
ALERT_EMAIL_TO=
